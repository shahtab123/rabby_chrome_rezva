# Local Rezva credentials for Rabby Chrome-extension development.
# Copy to .env.local (never commit the copy) or paste the key in Send.
#
# OpenAPI bearerAuth accepts an approved Provider API key or a Free API key.
# Prefer the Provider key for approved wallet-provider testing.
#
# API base URL:
# - Local/debug (default when webpack DEBUG=true and this is unset):
#   REZVA_API_BASE_URL=http://127.0.0.1:8787
# - Production (default for release/pro builds when unset):
#   REZVA_API_BASE_URL=https://universal-payment-api.sabrishahtab.workers.dev
#
# Set explicitly to override the build-mode default.
REZVA_PROVIDER_API_KEY=
REZVA_FREE_API_KEY=
REZVA_API_BASE_URL=https://universal-payment-api.sabrishahtab.workers.dev
